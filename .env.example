# Export these values before starting the service; .env is not loaded automatically.
OPENAI_API_KEY=replace-me
REPORT_AGENT_MODEL=your-tool-capable-model
# Optional OpenAI-compatible endpoint:
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
REPORT_AGENT_SKILLS=.agents/skills
REPORT_AGENT_TIMEZONE=America/New_York
REPORT_AGENT_TIMEOUT=120
REPORT_AGENT_MAX_TOKENS=4096
# Optional system-prompt control for models such as Muse Glimmer:
# REPORT_AGENT_REASONING_STRENGTH=low
# Optional SQLAlchemy URL referenced by a connections YAML file:
# REPORT_DATABASE_URL=sqlite:////absolute/path/to/reports.db
